  "poetry": [
    {
      "line": 980,
      "title": "七律·长征",
      "date": "1935年10月",
      "author": "毛泽东",
      "text": "红军不怕远征难，万水千山只等闲。五岭逶迤腾细浪，乌蒙磅礴走泥丸。金沙水拍云崖暖，大渡桥横铁索寒。更喜岷山千里雪，三军过后尽开颜。"
    },
    {
      "line": 1450,
      "title": "忆秦娥·娄山关",
      "date": "1935年2月",
      "author": "毛泽东",
      "text": "西风烈，长空雁叫霜晨月。霜晨月，马蹄声碎，喇叭声咽。雄关漫道真如铁，而今迈步从头越。从头越，苍山如海，残阳如血。"
    },
    {
      "line": 1930,
      "title": "清平乐·六盘山",
      "date": "1935年10月",
      "author": "毛泽东",
      "text": "天高云淡，望断南飞雁。不到长城非好汉，屈指行程二万。六盘山上高峰，红旗漫卷西风。今日长缨在手，何时缚住苍龙？"
    },
    {
      "line": 2240,
      "title": "十六字令·其一",
      "date": "1934—1935年",
      "author": "毛泽东",
      "text": "山，快马加鞭未下鞍。惊回首，离天三尺三。"
    }
  ]
}